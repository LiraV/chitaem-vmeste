# ---- Сервер (никогда не попадает в браузер) ----

# Какой моделью отвечать: yandex | anthropic
# yandex    — Yandex Foundation Models. Внутри Яндекс Облака ключ не нужен
#             вообще: контейнер авторизуется своим сервисным аккаунтом.
# anthropic — Claude API. В России недоступен.
LLM_PROVIDER=yandex

# --- если LLM_PROVIDER=yandex ---
YANDEX_FOLDER_ID=b1g...
# YANDEX_MODEL=yandexgpt          # или yandexgpt-lite, или полный gpt://...
# YANDEX_API_KEY=...              # только для запуска вне Яндекс Облака
# YANDEX_TEMPERATURE=0.6

# --- если LLM_PROVIDER=anthropic ---
# Не добавляйте префикс VITE_ — иначе ключ окажется в клиентском бандле.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# Порт для `npm start`. По умолчанию 3000.
# PORT=3000

# Origin'ы, которым разрешено обращаться к /api/claude из браузера.
# Нужно только если фронтенд живёт на другом домене (GitHub Pages).
# Схема + хост, без пути и без слэша в конце. Через запятую.
# ALLOWED_ORIGINS=https://lirav.github.io

# ---- Сборка фронтенда (попадает в бандл — секретов сюда нельзя) ----

# Адрес бэкенда. Пусто = тот же домен.
# VITE_API_URL=https://<container_id>.containers.yandexcloud.net

# Префикс пути для GitHub Pages. Workflow подставляет его сам.
# VITE_BASE=/chitaem-vmeste/
