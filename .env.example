# ---- Сервер (никогда не попадает в браузер) ----

# Поставщик модели: openai | anthropic | yandex
# Если не задан — определяется по тому, какой ключ присутствует.
# LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# OPENAI_TEMPERATURE=0.7    # не задавайте для reasoning-моделей: они его отвергают

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Yandex Foundation Models ---
# Внутри Яндекс Облака ключ не нужен: контейнер авторизуется своим
# сервисным аккаунтом через metadata-сервис.
# YANDEX_FOLDER_ID=b1g...
# YANDEX_MODEL=yandexgpt
# YANDEX_API_KEY=...        # только для запуска вне Яндекс Облака

# Порт для `npm start`. По умолчанию 3000.
# PORT=3000

# Origin'ы, которым разрешено обращаться к /api/claude из браузера.
# Нужно только если фронтенд на другом домене (GitHub Pages).
# Схема + хост, без пути и без слэша в конце. Через запятую.
# ALLOWED_ORIGINS=https://lirav.github.io

# ---- Сборка фронтенда (попадает в бандл — секретов сюда нельзя) ----

# Адрес бэкенда. Пусто = тот же домен.
# VITE_API_URL=https://chitaem-vmeste.vercel.app

# Префикс пути для GitHub Pages. Workflow подставляет его сам.
# VITE_BASE=/chitaem-vmeste/
