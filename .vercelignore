# Что не нужно отправлять в Vercel при деплое из терминала.
# Сборка идёт на их стороне: они сами ставят зависимости по package.json,
# поэтому локальные node_modules и dist слать незачем — без этого файла
# в загрузку уходит вся папка целиком, гигабайтами.

node_modules
dist
.git

# Исходные листы с ассетами: нужны для нарезки, на сайте не используются.
assets-source

# Локальное окружение и служебное
.env
.env.*
!.env.example
.vercel
tools
telegram-bot
docs
*.log
.DS_Store
